# Template for .env.local — copy this file to .env.local and fill in real values.
#
#   cp .env.example .env.local
#
# .env.local is gitignored and must NEVER be committed or shared over chat/email.
# The real values live in the Vercel project settings; the quickest way to get
# them onto a new machine is:
#
#   npx vercel login && npx vercel link && npx vercel env pull .env.local
#
# See docs/MAC-SETUP.md for the full walkthrough.

# --- Clerk (auth) --- required for /members, /studio, /admin/content
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Supabase --- votes, official tiers, and the content CMS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: bypasses RLS, server-side only. Treat as a password.
# Also needed by the pre-commit hook (scripts/hooks/pre-commit-pull-tiers.mjs),
# which pulls live official tiers into heros.json/legacy.json before a commit.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin gate --- comma-separated Clerk user ids allowed into the admin UI.
# Optional: a Clerk user with publicMetadata.role === 'admin' also passes.
ADMIN_USER_IDS=

# --- Analytics --- optional locally; leave blank to skip GTM in dev
NEXT_PUBLIC_GTM_ID=

# --- Data sync scripts --- only needed when running scripts/sync-gf-*.mjs
GODFORGE_API_KEY=
YOUTUBE_API_KEY=

# --- Game-data pipeline (Windows PC only) ---
# Default to E:\GameAssets\Exports on the PC. The extraction itself needs the
# installed game clients + AssetStudio, so these stay unset on a Mac.
GAME_EXPORTS_DIR=
DCDL_EXPORT=

# --- Clerk user migration (scripts/migrate-clerk-users.mjs only) ---
CLERK_DEV_SECRET_KEY=
CLERK_PROD_SECRET_KEY=
