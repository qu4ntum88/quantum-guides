  "guide": {
    "overview": "Nurse Harley enhances her basic attacks while in **[Self-Actualization]**, stacking **[Corrosion]** for sustained damage. She deals extra damage to enemies suffering from **debuffs**, and grows even stronger when paired with **[Arkham's Most Wanted]** Champions.",
    "recommendedStats": [
      "ATK",
      "Crit Rate",
      "Effect ACC"
    ],
    "tags": [
      "Physical DPS",
      "DMG Over Time"
    ],
    "bestFor": [
      "Meta Brawl",
      "Combat Cycle",
      "Anti-Crime Network"
    ],
    "legacyPieces": [
      {
        "id": "psycho_syringe",
        "name": "Psycho Syringe",
        "reason": "Nurse Harley's signature gear. Grants bonus Crit Rate and stacking Crit Damage, perfectly complementing her rapid-fire enhanced basic attacks. Also boosts her Attack and, during her Ultimate, causes her basic attacks to deal extra physical damage based on the target's Max HP, ideal for shredding tanky enemies on the front row. A must-have for maintaining high burst and relentless pressure while in [Self-Actualization]",
        "signature": true
      },
      {
        "id": "tectonic_disruptor",
        "name": "Tectonic Disruptor",
        "reason": "Increases Crit Rate and has a chance to reduce enemy healing. Nurse Harley's enhanced basic attacks inflict [Corrosion] for sustained damage, and the healing reduction ensures affected enemies steadily lose HP over time until they're defeated.",
        "signature": false
      },
      {
        "id": "cold_gun",
        "name": "Cold Gun",
        "reason": "Increases Attack and Accuracy. Nurse Harley needs her attacks to land to inflict [Corrosion], and the Accuracy bonus ensures each corrosive shot hits its target.",
        "signature": false
      },
      {
        "id": "lawton_rifle_scope",
        "name": "Lawton Rifle Scope",
        "reason": "Provides steady Attack and Crit Rate bonuses. Nurse Harley gains increased Crit Rate in her enhanced state, and the Lawton Rifle Scope further boosts it, helping her land critical hits consistently.",
        "signature": false
      }
    ],
